{
  "name": "starsbot",
  "version": "1.0.0",
  "description": "Telegram bot for tracking gift upgrades and unique gift crafts in real-time",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/core.test.ts",
    "benchmark:notifications": "tsx src/scripts/benchmarkNotifications.ts"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "grammy",
    "stars",
    "gifts",
    "upgrades",
    "nft",
    "mtproto"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/menu": "^1.3.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
