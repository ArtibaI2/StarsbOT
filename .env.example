# Copy this file to .env and fill in real values. Never commit .env.

BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the admin panel.
ADMIN_IDS=123456789

# Optional: MTProto credentials from https://my.telegram.org
# Required for authoritative "is this gift on a profile?" validation.
# Without them the bot falls back to Fragment HTML parsing (less reliable).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# Optional: TONAPI key from https://tonapi.io
# TONAPI_KEY=

# Optional: MRKT API token
# MRKT_AUTH_TOKEN=

# Polling intervals (seconds)
CRAFT_POLL_INTERVAL_SEC=5
STORE_POLL_INTERVAL_SEC=30
MRKT_SYNC_INTERVAL_SEC=60

DATA_DIR=./data
PORT=8080
